    {
      "type": "stat",
      "id": 9,
      "title": "Backup age",
      "description": "Hours since the oldest of the two backups (db/images) last succeeded. Requires the backup push jobs.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
