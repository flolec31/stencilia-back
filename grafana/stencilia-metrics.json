      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 13
      },
      "targets": [
        {
          "refId": "A",
          "expr": "stencilia_requests_lost_unopened",
          "instant": true,
